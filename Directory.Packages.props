<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Application">
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.12" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
    <!-- Exact version: only versions whose author published a responsible declaration (see README). -->
    <PackageVersion Include="VeriFactu" Version="[1.0.69]" />
  </ItemGroup>

  <ItemGroup Label="Transitive pins">
    <!-- VeriFactu depends on 10.0.11, which has known vulnerabilities (fixed in 10.0.13). Drop these
         pins once a VeriFactu version requires a patched one. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- WireMock.Net depends on 2.3.0, which has a known vulnerability (GHSA-6527-9fp8-r4x6, fixed in a
         later 2.3.x). Drop this pin once WireMock.Net requires a patched one. -->
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="2.3.14" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="WireMock.Net" Version="2.32.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>

</Project>
